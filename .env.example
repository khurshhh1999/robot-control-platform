# Copy this file to .env and replace placeholders before running services.
# Do not commit .env. Environment variables are the only runtime configuration.

RCP_ENV=development
RCP_LOG_LEVEL=INFO
RCP_DATABASE_HOST=db
RCP_DATABASE_PORT=5432
RCP_DATABASE_NAME=robot_platform
RCP_DATABASE_USER=robot_app
RCP_DATABASE_PASSWORD=change-me
RCP_ARTIFACT_ROOT=/var/lib/robot-platform/artifacts
RCP_API_BASE_URL=http://api:8000
RCP_WORKER_ID=local-simulator-1
RCP_RUN_LEASE_SECONDS=30
RCP_RUN_HEARTBEAT_SECONDS=10
RCP_SIMULATION_GUI=false
